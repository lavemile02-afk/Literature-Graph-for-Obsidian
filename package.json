{
	"name": "literature-graph",
	"version": "1.2.0",
	"description": "A citation graph of your Markdown literature notes: how they cite each other and the works they cite, from their reference lists, citation links and OpenAlex.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"notices": "node scripts/notices.mjs",
		"test": "node scripts/test.mjs"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"citations",
		"literature",
		"graph"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/d3-force": "^3.0.10",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"d3-force": "^3.0.0",
		"pixi.js": "^8.21.0",
		"umap-js": "^1.4.0"
	}
}
